# VENSEVEN Server Environment Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/venseven?retryWrites=true&w=majority

# JWT Signing Secret (Generate a strong 64-char random string: openssl rand -base64 32)
JWT_SECRET=your_production_jwt_secret_key_here

# Frontend Application Origin (Used for CORS and transactional email links)
CLIENT_URL=https://venseven.com

# Razorpay Payment Gateway (Test or Live mode credentials)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Cloudinary Media Management (Product image storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP Email Delivery (Transactional emails, order confirmations & password resets)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_smtp_api_password
EMAIL_FROM=VENSEVEN Studio <noreply@venseven.com>
