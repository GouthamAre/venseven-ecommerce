# =================================================================
# VENSEVEN Server - Production Environment Template
# Duplicate this file as .env.production or configure these variables
# directly in your Render Dashboard (Service Settings > Environment)
# =================================================================

# Server Port & Environment Mode
PORT=5000
NODE_ENV=production

# MongoDB Atlas Production Connection URI
# Replace with your production database connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/venseven?retryWrites=true&w=majority

# =================================================================
# JWT Authentication Security (HS256)
# =================================================================
# REQUIRED in production: Must be at least 32 cryptographically random characters.
# Generate on command line via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_production_jwt_secret_min_32_characters_random_hex
JWT_EXPIRES_IN=7d

# Optional HMAC-SHA256 Secret for Phone OTP token hashing
OTP_HASH_SECRET=your_production_otp_hmac_secret_min_32_characters

# Frontend Whitelist (Comma-separated origins for CORS)
CLIENT_URL=https://venseven-ecommerce.vercel.app,http://localhost:5173

# =================================================================
# Google OAuth 2.0 Identity Verification
# =================================================================
GOOGLE_CLIENT_ID=56073671076-qsovbdmh0rhhbh3ru88b7t7105sai7v0.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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

# =================================================================
# SMS Gateway / OTP Delivery Providers
# =================================================================
# Supported providers: 'twilio', 'msg91', 'custom'
# Note: 'dev' simulated OTP is disabled when NODE_ENV=production
SMS_PROVIDER=twilio

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# MSG91 SMS Configuration
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_dlt_template_id
MSG91_SENDER_ID=VN7VEN

# Custom SMS Webhook Gateway
SMS_WEBHOOK_URL=https://your-sms-api.com/send
SMS_WEBHOOK_HEADER_NAME=Authorization
SMS_WEBHOOK_HEADER_VALUE=Bearer your_api_token

# =================================================================
# Payment Gateway (Razorpay)
# =================================================================
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# =================================================================
# Cloud Media Storage (Cloudinary)
# =================================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# =================================================================
# Transactional Email (SMTP Service e.g., SendGrid, Postmark, AWS SES)
# =================================================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_smtp_api_password
EMAIL_FROM=VENSEVEN Studio <noreply@venseven-ecommerce.vercel.app>
