# VENSEVEN Client Environment Configuration
# IMPORTANT: Only public configuration prefixed with VITE_ may be included here.
# NEVER add API secrets, private keys, or backend signing keys to this client environment file.

# Backend API Base URL (Production Example: https://api.venseven.com or https://venseven-backend.onrender.com)
VITE_API_URL=http://localhost:5000

# Razorpay Public Key ID (Frontend SDK checkout key only - Never add RAZORPAY_KEY_SECRET here)
VITE_RAZORPAY_KEY_ID=

# Cloudinary Public Cloud Name (for client media delivery)
VITE_CLOUDINARY_CLOUD_NAME=

# Sanity CMS Public Configuration (if connecting to studio)
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-03-01
