# =================================================================
# VENSEVEN Client - Production Environment Template
# Duplicate this file as .env.production or copy these variables into
# your Vercel Project Dashboard (Settings > Environment Variables)
# =================================================================

# Production Backend API Endpoint (e.g., your Render web service URL)
# Example: https://venseven-backend.onrender.com or https://api.yourdomain.com
VITE_API_URL=https://venseven-backend.onrender.com

# Google OAuth 2.0 Web Client ID (from Google Cloud Console)
# Ensure your production frontend domain (https://venseven-ecommerce.vercel.app)
# is listed under "Authorized JavaScript origins" and "Authorized redirect URIs"
VITE_GOOGLE_CLIENT_ID=56073671076-qsovbdmh0rhhbh3ru88b7t7105sai7v0.apps.googleusercontent.com

# Razorpay Checkout Public Key (Key ID only - NEVER put RAZORPAY_KEY_SECRET here)
# Example: rzp_live_xxxxxxxxxxxxxxxx or rzp_test_xxxxxxxxxxxxxxxx
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here

# Cloudinary Public Cloud Name (for responsive image delivery)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Sanity CMS Public Configuration
VITE_SANITY_PROJECT_ID=your_sanity_project_id
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-03-01
